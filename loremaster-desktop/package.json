{
  "name": "spins-loremaster",
  "private": true,
  "version": "0.3.4",
  "author": "SpinUI",
  "description": "Live EverQuest Legends combat, mez, lull, and weekly progress companion",
  "desktopName": "loremaster.desktop",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -p tsconfig.electron.json && tsc --noEmit && vite build",
    "preview": "electron .",
    "dist:windows": "pnpm build && electron-builder --win portable --x64 --publish never",
    "dist:linux": "pnpm build && electron-builder --linux AppImage tar.gz --x64 --publish never",
    "test:fixtures": "node scripts/validate-fixture.mjs",
    "test:gear": "node scripts/test-gear-plan.cjs",
    "test:items": "node scripts/test-item-intelligence.cjs",
    "test:updates": "node scripts/test-portable-updater.cjs",
    "test:skin-updates": "node scripts/test-spinui-updater.cjs",
    "test:alert-placement": "node scripts/test-alert-placement.cjs",
    "test:rc-backup": "node scripts/test-rc-backup.cjs"
  },
  "dependencies": {
    "@electron-internal/extract-zip": "1.0.5",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.10",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "electron": "43.3.0",
    "electron-builder": "26.15.7",
    "typescript": "5.7.3",
    "vite": "6.1.0",
    "wait-on": "8.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.16.0",
  "build": {
    "appId": "com.spinui.loremaster",
    "productName": "Loremaster",
    "asar": true,
    "directories": {
      "output": "../dist-electron-release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Loremaster.exe",
      "icon": "../loremaster/assets/loremaster.ico",
      "extraResources": [
        {
          "from": "../dist/LoremasterEngine.exe",
          "to": "engine/LoremasterEngine.exe"
        }
      ]
    },
    "linux": {
      "publish": [
        {
          "provider": "github",
          "owner": "JDS300",
          "repo": "spinips"
        }
      ],
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "loremaster",
      "category": "Game",
      "synopsis": "Live EverQuest Legends combat, mez, lull, and weekly progress companion",
      "syncDesktopName": true,
      "icon": "../loremaster/assets/loremaster-256.png",
      "artifactName": "Loremaster-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "../loremaster",
          "to": "engine",
          "filter": [
            "*.py"
          ]
        },
        {
          "from": "../loremaster/assets/plane_of_sky_quests.json",
          "to": "engine/assets/plane_of_sky_quests.json"
        }
      ],
      "executableArgs": [
        "--ozone-platform=x11"
      ]
    }
  }
}
